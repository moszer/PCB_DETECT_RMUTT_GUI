# RMUTT PCB AOI Station — local settings and secrets (copied to backend/.env by install.sh).
# backend/.env is git-ignored: never commit real keys.

# Operator passcode for taking control of the station (default: rmutt-aoi). Change it!
# PCB_OPERATOR_PASSCODE=change-me

# AI assistant / board chat. Gemini key from https://aistudio.google.com/apikey
# AI_PROVIDER=gemini
# GEMINI_API_KEY=
# GEMINI_MODELS=gemini-flash-latest,gemini-3.8-flash,gemini-3.5-flash,gemini-flash-lite-latest

# Or OpenRouter (https://openrouter.ai/keys)
# AI_PROVIDER=openrouter
# OPENROUTER_API_KEY=
# OPENROUTER_MODEL=qwen/qwen3.8-27b:free

# AI device: auto | cuda:0 | mps | cpu
# PCB_DEVICE=auto

# Use the software test camera instead of a real one (e.g. in Docker without /dev/video0)
# PCB_CAMERA_SIMULATION=1

# YOLO weights on Hugging Face (install.sh downloads best.pt from here when it is missing,
# and Settings > Models lists everything in the repo). Public repos need no token.
# PCB_MODEL_REPO=Moszer777/pcb-aoi-yolo-rmutt
# PCB_MODEL_FILE=best.pt
# HF_TOKEN=            # only for a private repo (read access); stays on the server
